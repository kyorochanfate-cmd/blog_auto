# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# はてな初期シード用 (任意。Firestoreにブログ0件のとき1件目として自動登録)
HATENA_ID=
HATENA_API_KEY=
HATENA_BLOG_DOMAIN=

# Google ログイン
# OAuth Client ID は Google Cloud Console > APIs & Services > Credentials で作成
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
ALLOWED_EMAILS=you@gmail.com,another@gmail.com

# Flask セッション署名鍵
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=random_long_string_here

# 自動運用 (Cloud Scheduler → /auto-run の認証)
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 未設定だと自動運用エンドポイントは無効 (401)。
AUTO_RUN_TOKEN=random_long_string_here

# 通知メール (NG時のスマホ通知用 — Gmail SMTP)
# NOTIFY_GMAIL_APP_PASSWORD は https://myaccount.google.com/apppasswords で発行する16桁
NOTIFY_EMAIL=kyorochan.fate@gmail.com
NOTIFY_GMAIL_ADDRESS=kyorochan.fate@gmail.com
NOTIFY_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
